{
  "name": "madlogic-learning-core",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Early-stage framework-neutral TypeScript learning engine contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run clean && tsc -b --pretty false",
    "test": "npm run build && node --test tests/*.test.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run security:scan"
  }
}
